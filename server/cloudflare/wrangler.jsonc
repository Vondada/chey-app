{
  "name": "chey-app",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  // Nightly review at 07:07 UTC (about 2 AM Central).
  "triggers": { "crons": ["7 7 * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "CHE_STATE", "class_name": "CheState" }]
  },
  "exports": {
    "CheState": { "type": "durable-object", "storage": "sqlite" }
  },
  // Required by `npx wrangler preview`; empty means previews inherit the top-level settings.
  "previews": {}
}
