{
  "name": "chey-app",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  // Lets /health and CHE's deploy verification report which version is live
  // (the deploy workflow tags each version with its git commit).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Non-secret repository target for CHE's owner-approved self-development.
  // The write credential itself remains the encrypted CHE_GITHUB_TOKEN secret.
  "vars": { "CHE_GITHUB_REPO": "Vondada/chey-app" },
  // Nightly review at 07:07 UTC (about 2 AM Central).
  "triggers": { "crons": ["7 7 * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "CHE_STATE", "class_name": "CheState" }]
  },
  "exports": {
    "CheState": { "type": "durable-object", "storage": "sqlite" }
  },
  // Worker Previews do not inherit env bindings from production. CHE reads
  // both AI and CHE_STATE from env, so repeat those bindings for every PR preview.
  "previews": {
    "ai": { "binding": "AI" },
    "durable_objects": {
      "bindings": [{ "name": "CHE_STATE", "class_name": "CheState" }]
    }
  }
}
